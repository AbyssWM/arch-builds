# Pinned development snapshot; native Arch build verified 2026-10-18.
pkgname=abyssutils
pkgver=0.14.2.r20261027.gf1f540b
pkgrel=1
pkgdesc='Utility library for the Abyss ecosystem'
arch=('x86_64')
url='https://github.com/AbyssWM/Abyssutils'
license=('BSD-3-Clause')
depends=('pixman')
makedepends=('cmake' 'ninja' 'pkgconf')
source=('Abyssutils-f1f540b7121f6db3c0bb8518a072c1a79755cd82.tar.gz::https://github.com/AbyssWM/Abyssutils/archive/f1f540b7121f6db3c0bb8518a072c1a79755cd82.tar.gz')
sha256sums=('7a579a81abc1dce8ba65e14ffde83f15acd03aa4b07788c5d03a764cce2a7462')

build() {
	cmake -S "$srcdir/Abyssutils-f1f540b7121f6db3c0bb8518a072c1a79755cd82" -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_SYSCONFDIR=/etc \
		-DCMAKE_BUILD_TYPE=Release \
		-DBUILD_TESTING=OFF \
		-DFETCHCONTENT_FULLY_DISCONNECTED=ON
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	install -Dm644 "$srcdir/Abyssutils-f1f540b7121f6db3c0bb8518a072c1a79755cd82/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
