# Pinned development snapshot; native Arch build verified 2026-10-18.
pkgname=abyss-scanner
pkgver=0.4.5.r20261017.g84f54bf
pkgrel=1
pkgdesc='C++ Wayland protocol scanner for Abyss'
arch=('x86_64')
url='https://github.com/AbyssWM/Abyss-scanner'
license=('BSD-3-Clause')
depends=('pugixml')
makedepends=('cmake' 'ninja' 'pkgconf')
source=('Abyss-scanner-84f54bf0d3074ef8700d3e89699181accdd28cba.tar.gz::https://github.com/AbyssWM/Abyss-scanner/archive/84f54bf0d3074ef8700d3e89699181accdd28cba.tar.gz')
sha256sums=('82528be339b642f28a38ca495a6388300313dce37e624d67ae2c88e3992a1255')

build() {
	cmake -S "$srcdir/Abyss-scanner-84f54bf0d3074ef8700d3e89699181accdd28cba" -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_SYSCONFDIR=/etc \
		-DCMAKE_BUILD_TYPE=Release \
		-DBUILD_TESTING=OFF \
		-DFETCHCONTENT_FULLY_DISCONNECTED=ON
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	install -Dm644 "$srcdir/Abyss-scanner-84f54bf0d3074ef8700d3e89699181accdd28cba/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
