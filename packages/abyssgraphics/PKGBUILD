# Pinned development snapshot; native Arch build pending.
pkgname=abyssgraphics
pkgver=0.5.1.r20261017.g22ddc75
pkgrel=1
pkgdesc='Graphics and resource library for Abyss'
arch=('x86_64')
url='https://github.com/AbyssWM/Abyssgraphics'
license=('BSD-3-Clause')
depends=('abyssutils' 'cairo' 'file' 'libdrm' 'libglvnd' 'libheif' 'libjpeg-turbo' 'libjxl' 'libpng' 'librsvg' 'libwebp' 'mesa' 'pango' 'pixman')
makedepends=('cmake' 'ninja' 'pkgconf')
source=('Abyssgraphics-22ddc7596eefffcee611181a556ff1a753eaf433.tar.gz::https://github.com/AbyssWM/Abyssgraphics/archive/22ddc7596eefffcee611181a556ff1a753eaf433.tar.gz')
sha256sums=('b254c6ed189468c5408a910cce14c48d3f1105a3bcbe81af82052993e515c22b')

build() {
	cmake -S "$srcdir/Abyssgraphics-22ddc7596eefffcee611181a556ff1a753eaf433" -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_SYSCONFDIR=/etc \
		-DCMAKE_BUILD_TYPE=Release \
		-DBUILD_TESTING=OFF \
		-DFETCHCONTENT_FULLY_DISCONNECTED=ON
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	install -Dm644 "$srcdir/Abyssgraphics-22ddc7596eefffcee611181a556ff1a753eaf433/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
