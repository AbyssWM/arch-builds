# Pinned development snapshot; native Arch build verified 2026-10-18.
pkgname=abyssgraphics
pkgver=0.5.1.r20261027.g5f590f2
pkgrel=1
pkgdesc='Graphics and resource library for Abyss'
arch=('x86_64')
url='https://github.com/AbyssWM/Abyssgraphics'
license=('BSD-3-Clause')
depends=('abyssutils' 'cairo' 'file' 'libdrm' 'libglvnd' 'libheif' 'libjpeg-turbo' 'libjxl' 'libpng' 'librsvg' 'libwebp' 'mesa' 'pango' 'pixman')
makedepends=('cmake' 'ninja' 'pkgconf')
source=('Abyssgraphics-5f590f21086f9c1fbb0ca1b0c1d7ffebdfb60945.tar.gz::https://github.com/AbyssWM/Abyssgraphics/archive/5f590f21086f9c1fbb0ca1b0c1d7ffebdfb60945.tar.gz')
sha256sums=('5a191c008e3f2719fbd10633e48fa1b40bbf9742593b7f7e5e043c3a0972458d')

build() {
	cmake -S "$srcdir/Abyssgraphics-5f590f21086f9c1fbb0ca1b0c1d7ffebdfb60945" -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_SYSCONFDIR=/etc \
		-DCMAKE_BUILD_TYPE=Release \
		-DBUILD_TESTING=OFF \
		-DFETCHCONTENT_FULLY_DISCONNECTED=ON
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	install -Dm644 "$srcdir/Abyssgraphics-5f590f21086f9c1fbb0ca1b0c1d7ffebdfb60945/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
