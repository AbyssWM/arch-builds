# Pinned development snapshot; native Arch build verified 2026-10-18.
pkgname=abysspolkit
pkgver=0.2.0.r20261027.gb3a214b
pkgrel=1
pkgdesc='Polkit authentication agent for Abyss'
arch=('x86_64')
url='https://github.com/AbyssWM/AbyssPolkit'
license=('BSD-3-Clause')
depends=('abyssgraphics' 'abyssparse' 'abysstoolkit' 'abyssutils' 'libdrm' 'pixman' 'polkit' 'sdbus-cpp')
makedepends=('cmake' 'ninja' 'pkgconf')
source=('AbyssPolkit-b3a214b1948dcebd2f5f0f6cab2e6fdddf7cd486.tar.gz::https://github.com/AbyssWM/AbyssPolkit/archive/b3a214b1948dcebd2f5f0f6cab2e6fdddf7cd486.tar.gz')
sha256sums=('9802a003f2dec0fb8b73adedf2d770a548a20e46d416b77b884768a21e1195dd')

build() {
	cmake -S "$srcdir/AbyssPolkit-b3a214b1948dcebd2f5f0f6cab2e6fdddf7cd486" -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_SYSCONFDIR=/etc \
		-DCMAKE_BUILD_TYPE=Release \
		-DBUILD_TESTING=OFF \
		-DFETCHCONTENT_FULLY_DISCONNECTED=ON
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	install -Dm644 "$srcdir/AbyssPolkit-b3a214b1948dcebd2f5f0f6cab2e6fdddf7cd486/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
