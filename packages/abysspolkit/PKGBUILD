# Pinned development snapshot; native Arch build verified 2026-10-18.
pkgname=abysspolkit
pkgver=0.2.0.r20261027.gd9bc965
pkgrel=1
pkgdesc='Polkit authentication agent for Abyss'
arch=('x86_64')
url='https://github.com/AbyssWM/AbyssPolkit'
license=('BSD-3-Clause')
depends=('abyssgraphics' 'abyssparse' 'abysstoolkit' 'abyssutils' 'libdrm' 'pixman' 'polkit' 'sdbus-cpp')
makedepends=('cmake' 'ninja' 'pkgconf')
source=('AbyssPolkit-d9bc965683bb4b0b90d6039b22fbd39423a37c86.tar.gz::https://github.com/AbyssWM/AbyssPolkit/archive/d9bc965683bb4b0b90d6039b22fbd39423a37c86.tar.gz')
sha256sums=('a5e5d65028067d7b57faa44b82a026cd371009d054cf5fde91751a1e4faaedeb')

build() {
	cmake -S "$srcdir/AbyssPolkit-d9bc965683bb4b0b90d6039b22fbd39423a37c86" -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_SYSCONFDIR=/etc \
		-DCMAKE_BUILD_TYPE=Release \
		-DBUILD_TESTING=OFF \
		-DFETCHCONTENT_FULLY_DISCONNECTED=ON
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	install -Dm644 "$srcdir/AbyssPolkit-d9bc965683bb4b0b90d6039b22fbd39423a37c86/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
