# Pinned development snapshot; native Arch build verified 2026-10-18.
pkgname=abyssdusk
pkgver=0.4.0.r20261027.gb383b37
pkgrel=1
pkgdesc='Display color temperature manager for Abyss'
arch=('x86_64')
url='https://github.com/AbyssWM/AbyssDusk'
license=('BSD-3-Clause')
depends=('abyssparse' 'abyssutils' 'wayland' 'wayland-protocols')
makedepends=('abyss-scanner' 'abyssland-protocols' 'cmake' 'ninja' 'pkgconf')
source=('AbyssDusk-b383b3706c40b8b6c0c76ec359ca4b89652f9b46.tar.gz::https://github.com/AbyssWM/AbyssDusk/archive/b383b3706c40b8b6c0c76ec359ca4b89652f9b46.tar.gz')
sha256sums=('7cabb12e3d8eb24cad418a17b1e498f18a9e501066426131ad3a698c6608019a')

build() {
	cmake -S "$srcdir/AbyssDusk-b383b3706c40b8b6c0c76ec359ca4b89652f9b46" -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_SYSCONFDIR=/etc \
		-DCMAKE_BUILD_TYPE=Release \
		-DBUILD_TESTING=OFF \
		-DFETCHCONTENT_FULLY_DISCONNECTED=ON
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	install -Dm644 "$srcdir/AbyssDusk-b383b3706c40b8b6c0c76ec359ca4b89652f9b46/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
