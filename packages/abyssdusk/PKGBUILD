# Pinned development snapshot; native Arch build verified 2026-10-18.
pkgname=abyssdusk
pkgver=0.4.0.r20261027.g6c58248
pkgrel=1
pkgdesc='Display color temperature manager for Abyss'
arch=('x86_64')
url='https://github.com/AbyssWM/AbyssDusk'
license=('BSD-3-Clause')
depends=('abyssparse' 'abyssutils' 'wayland' 'wayland-protocols')
makedepends=('abyss-scanner' 'abyssland-protocols' 'cmake' 'ninja' 'pkgconf')
source=('AbyssDusk-6c58248dbd91d392fde18aa7764181b80b2da539.tar.gz::https://github.com/AbyssWM/AbyssDusk/archive/6c58248dbd91d392fde18aa7764181b80b2da539.tar.gz')
sha256sums=('9cced56fb5bc428081dddb36293241fd9ef6d006aa5e63a34881742ebb9dc077')

build() {
	cmake -S "$srcdir/AbyssDusk-6c58248dbd91d392fde18aa7764181b80b2da539" -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_SYSCONFDIR=/etc \
		-DCMAKE_BUILD_TYPE=Release \
		-DBUILD_TESTING=OFF \
		-DFETCHCONTENT_FULLY_DISCONNECTED=ON
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	install -Dm644 "$srcdir/AbyssDusk-6c58248dbd91d392fde18aa7764181b80b2da539/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
