# Pinned development snapshot; native Arch build verified 2026-10-18.
pkgname=abysspicker
pkgver=0.4.7.r20261027.g6a4a1cc
pkgrel=1
pkgdesc='Wayland color picker for Abyss'
arch=('x86_64')
url='https://github.com/AbyssWM/AbyssPicker'
license=('BSD-3-Clause')
depends=('abyssutils' 'cairo' 'libjpeg-turbo' 'libxkbcommon' 'pango' 'wayland' 'wayland-protocols')
makedepends=('abyss-scanner' 'cmake' 'ninja' 'pkgconf')
source=('AbyssPicker-6a4a1ccf9de9b8c9a803f75e6e4829e907a08568.tar.gz::https://github.com/AbyssWM/AbyssPicker/archive/6a4a1ccf9de9b8c9a803f75e6e4829e907a08568.tar.gz')
sha256sums=('9fa5bd0c913e4cfff6e1e1b7d2d0161afb4c0310e77df161b9a9e4fd3db6bba2')

build() {
	cmake -S "$srcdir/AbyssPicker-6a4a1ccf9de9b8c9a803f75e6e4829e907a08568" -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_SYSCONFDIR=/etc \
		-DCMAKE_BUILD_TYPE=Release \
		-DBUILD_TESTING=OFF \
		-DFETCHCONTENT_FULLY_DISCONNECTED=ON
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	install -Dm644 "$srcdir/AbyssPicker-6a4a1ccf9de9b8c9a803f75e6e4829e907a08568/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
