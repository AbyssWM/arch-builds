# Pinned development snapshot; native Arch build verified 2026-10-18.
pkgname=abysspicker
pkgver=0.4.7.r20261027.g9724004
pkgrel=1
pkgdesc='Wayland color picker for Abyss'
arch=('x86_64')
url='https://github.com/AbyssWM/AbyssPicker'
license=('BSD-3-Clause')
depends=('abyssutils' 'cairo' 'libjpeg-turbo' 'libxkbcommon' 'pango' 'wayland' 'wayland-protocols')
makedepends=('abyss-scanner' 'cmake' 'ninja' 'pkgconf')
source=('AbyssPicker-97240042de866686f1da1db3847ddd5f37603e27.tar.gz::https://github.com/AbyssWM/AbyssPicker/archive/97240042de866686f1da1db3847ddd5f37603e27.tar.gz')
sha256sums=('e20ff9b5596a8db82b9a979c633ee92f04f70c31b3f875bf8305a2c44322519f')

build() {
	cmake -S "$srcdir/AbyssPicker-97240042de866686f1da1db3847ddd5f37603e27" -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_SYSCONFDIR=/etc \
		-DCMAKE_BUILD_TYPE=Release \
		-DBUILD_TESTING=OFF \
		-DFETCHCONTENT_FULLY_DISCONNECTED=ON
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	install -Dm644 "$srcdir/AbyssPicker-97240042de866686f1da1db3847ddd5f37603e27/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
