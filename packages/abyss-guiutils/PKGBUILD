# Pinned development snapshot; native Arch build verified 2026-10-18.
pkgname=abyss-guiutils
pkgver=0.2.2.r20261027.g0afda1e
pkgrel=1
pkgdesc='Dialogs and application tools for Abyss'
arch=('x86_64')
url='https://github.com/AbyssWM/Abyss-guiutils'
license=('BSD-3-Clause')
depends=('abyssparse' 'abysstoolkit' 'abyssutils' 'libdrm' 'libxkbcommon' 'pixman')
makedepends=('cmake' 'ninja' 'pkgconf')
source=('Abyss-guiutils-0afda1ef922bbdf63c74042642cf12a69a449320.tar.gz::https://github.com/AbyssWM/Abyss-guiutils/archive/0afda1ef922bbdf63c74042642cf12a69a449320.tar.gz')
sha256sums=('7ad0ced7f29b6e7c8b9c07541c77465bf56a17acb8be76a2565cc36bfe4febd5')

build() {
	cmake -S "$srcdir/Abyss-guiutils-0afda1ef922bbdf63c74042642cf12a69a449320" -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_SYSCONFDIR=/etc \
		-DCMAKE_BUILD_TYPE=Release \
		-DBUILD_TESTING=OFF \
		-DFETCHCONTENT_FULLY_DISCONNECTED=ON
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	install -Dm644 "$srcdir/Abyss-guiutils-0afda1ef922bbdf63c74042642cf12a69a449320/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
