# Pinned development snapshot; native Arch build verified 2026-10-18.
pkgname=abyss-guiutils
pkgver=0.2.2.r20261017.gda66469
pkgrel=1
pkgdesc='Dialogs and application tools for Abyss'
arch=('x86_64')
url='https://github.com/AbyssWM/Abyss-guiutils'
license=('BSD-3-Clause')
depends=('abyssparse' 'abysstoolkit' 'abyssutils' 'libdrm' 'libxkbcommon' 'pixman')
makedepends=('cmake' 'ninja' 'pkgconf')
source=('Abyss-guiutils-da6646906dab8557440ed8f5cca4157452105fc2.tar.gz::https://github.com/AbyssWM/Abyss-guiutils/archive/da6646906dab8557440ed8f5cca4157452105fc2.tar.gz')
sha256sums=('f2eb180c298dc718b8e3b144c9f114a05e4e9aacd852d01864162dda65a06d48')

build() {
	cmake -S "$srcdir/Abyss-guiutils-da6646906dab8557440ed8f5cca4157452105fc2" -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_SYSCONFDIR=/etc \
		-DCMAKE_BUILD_TYPE=Release \
		-DBUILD_TESTING=OFF \
		-DFETCHCONTENT_FULLY_DISCONNECTED=ON
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	install -Dm644 "$srcdir/Abyss-guiutils-da6646906dab8557440ed8f5cca4157452105fc2/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
